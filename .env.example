# ==============================================================================
# Clover 🍀 Full Stack & Cloudflare Deployment Environment Configuration
# ==============================================================================

# --- Runtime Environment ---
NODE_ENV=development
PORT=4000
API_PORT=4000
WEB_PORT=3000
WORKER_PORT=4001

# --- Client Application URLs ---
# In Cloudflare Workers deployment, leave empty to automatically bind to the origin
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
API_URL=http://localhost:4000

# --- Database: Supabase PostgreSQL ---
# Local Docker Postgres (default):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/roomsync

# Supabase Production Connection String (Transaction Pooler - Port 6543 recommended for serverless/Workers):
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Supabase API Credentials
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# NEVER expose the service-role key to client-side bundles!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Redis (Required for local Fastify & BullMQ Worker only) ---
# On Cloudflare Workers, real-time is handled by Durable Objects and background jobs by Cron Triggers.
REDIS_URL=redis://localhost:6379

# --- Automated External Database Backups ---
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=7
# Optional secondary mirror path (e.g., /mnt/backups or cloud volume)
BACKUP_EXTERNAL_DIR=

# --- Security & JWT ---
# In production, must be at least 32 characters of high-entropy string
JWT_SECRET=roomsync-super-secret-dev-jwt-key-32chars
ALLOW_LOCALHOST_IN_PROD=false

# --- Cloudflare Deployment Secrets (GitHub Actions / wrangler secret put) ---
# CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
# CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
