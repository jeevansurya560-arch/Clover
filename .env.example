# Clover 🍀 Household Workspace Configuration

# Runtime Environment
NODE_ENV=development
PORT=4000
API_PORT=4000
WEB_PORT=3000
WORKER_PORT=4001

# URLs
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
API_URL=http://localhost:4000

# Database Configuration (PostgreSQL / Supabase / Neon / RDS)
# In production (NODE_ENV=production), DATABASE_URL is strictly required and must not point to localhost
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/roomsync
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Redis Configuration (BullMQ Queues & Socket.IO Real-time Gateway)
# In production, REDIS_URL is strictly required. Redis must run with: maxmemory 256mb, maxmemory-policy noeviction
REDIS_URL=redis://localhost:6379

# Automated External Database Backups
# Backups generate compressed .sql.gz archives with SHA-256 integrity checksums
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=7
# Optional external volume mount or secondary path to mirror backups (e.g. /mnt/backups or D:\Backups)
BACKUP_EXTERNAL_DIR=

# Security & Authentication
# In production, JWT_SECRET must be a high-entropy secret string (minimum 32 characters)
JWT_SECRET=roomsync-super-secret-dev-jwt-key-32chars
# Set to 'true' only if deploying in an isolated container network where DB runs on localhost
ALLOW_LOCALHOST_IN_PROD=false
