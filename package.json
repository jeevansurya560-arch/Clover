{
  "name": "clover",
  "version": "1.0.0",
  "private": true,
  "description": "Clover 🍀 — Collaborative real-time shared household workspace for roommates",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:worker": "npm run dev --workspace=apps/worker",
    "build": "npm run build --workspaces --if-present",
    "test": "node scripts/run-tests.js",
    "test:finance": "node tests/financial/finance.test.js",
    "test:api": "node tests/integration/api.test.js",
    "test:security": "node tests/security/security.test.js",
    "test:redis": "node tests/redis/redis-memory.test.js",
    "test:backup": "node tests/backup/backup.test.js",
    "test:config": "node tests/config/env.test.js",
    "lint": "node scripts/lint-check.js",
    "docker:up": "node scripts/wait-docker.js",
    "docker:down": "docker compose down",
    "db:migrate": "node apps/api/src/database/migrate.js",
    "db:seed": "node apps/api/src/database/seed.js",
    "db:backup": "node scripts/backup-db.js",
    "db:restore": "node scripts/restore-db.js",
    "build:cf": "npm run build --workspace=apps/web",
    "deploy:cf": "npm run build:cf && npx wrangler deploy --env production",
    "deploy:preview": "npm run build:cf && npx wrangler deploy --env preview",
    "supabase:keepalive": "node scripts/supabase-keepalive.js"
  },
  "keywords": [
    "household",
    "roommates",
    "finance",
    "chores",
    "realtime",
    "nextjs",
    "fastify"
  ],
  "author": "RoomSync Team",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2"
  }
}
